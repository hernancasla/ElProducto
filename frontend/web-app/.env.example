# API Backend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Configuración de la aplicación
NEXT_PUBLIC_APP_NAME="ElProducto"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Backoffice Admin (REQUERIDO para acceso al panel de administración)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$YourBcryptHashHere
SESSION_SECRET=change_this_to_a_random_32_char_string

# IP Whitelist para acceso al backoffice (separadas por coma)
# Dejar vacío en desarrollo permite localhost automáticamente
# En producción, DEBE configurarse con IPs específicas
ADMIN_IP_WHITELIST=192.168.1.100,203.0.113.50

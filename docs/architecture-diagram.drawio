        <mxCell id="collector-endpoints" value="&lt;b&gt;Collection Endpoints&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /api/v1/collector/&lt;br&gt;• countries&lt;br&gt;• leagues&lt;br&gt;• teams&lt;br&gt;• players&lt;br&gt;• fixtures&lt;br&gt;• standings&lt;br&gt;• statistics&lt;br&gt;• events&lt;br&gt;• lineups" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left" vertex="1" parent="backend-collector-layer">
          <mxGeometry x="30" y="200" width="130" height="230" as="geometry" />
        </mxCell>

        <mxCell id="sync-endpoints" value="&lt;b&gt;Sync Management&lt;/b&gt;&lt;br&gt;&lt;br&gt;GET /api/v1/sync/&lt;br&gt;• running&lt;br&gt;• history/{type}&lt;br&gt;• stats/{type}&lt;br&gt;• last/{type}&lt;br&gt;&lt;br&gt;POST /api/v1/sync/trigger/&lt;br&gt;• countries&lt;br&gt;• leagues&lt;br&gt;• teams&lt;br&gt;• fixtures&lt;br&gt;• standings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left" vertex="1" parent="backend-collector-layer">

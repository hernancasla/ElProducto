        </mxCell>

        <!-- Frontend Layer -->
        <mxCell id="frontend-layer" value="Frontend Layer (Next.js 14 + PWA)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="360" width="600" height="460" as="geometry" />
        </mxCell>

        <mxCell id="web-app" value="&lt;b&gt;Web App (PWA)&lt;/b&gt;&lt;br&gt;&lt;br&gt;:3000&lt;br&gt;&lt;br&gt;• Páginas públicas&lt;br&gt;• Service Worker&lt;br&gt;• Responsive UI&lt;br&gt;• shadcn/ui components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="frontend-layer">
          <mxGeometry x="40" y="40" width="220" height="150" as="geometry" />
        </mxCell>

        <mxCell id="admin-backoffice" value="&lt;b&gt;Admin Backoffice&lt;/b&gt;&lt;br&gt;&lt;br&gt;:3001&lt;br&gt;&lt;br&gt;• Iron-session auth&lt;br&gt;• IP whitelisting&lt;br&gt;• Data collector UI&lt;br&gt;• Flyway migrations UI&lt;br&gt;• DB management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="frontend-layer">
          <mxGeometry x="320" y="40" width="240" height="150" as="geometry" />
        </mxCell>

        <mxCell id="proxy-routes" value="&lt;b&gt;Next.js API Routes (Server-side)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• /api/admin/auth (login/logout)&lt;br&gt;• /api/admin/collector/* (proxy to api-service)&lt;br&gt;• /api/admin/migrations/* (proxy to api-service)&lt;br&gt;&lt;br&gt;Agrega: X-Admin-Api-Key header&lt;br&gt;Valida: iron-session" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left" vertex="1" parent="frontend-layer">
          <mxGeometry x="40" y="230" width="520" height="200" as="geometry" />
        </mxCell>

        <!-- Backend API Layer -->
        <mxCell id="backend-api-layer" value="Backend - API Service (Spring Boot)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="760" y="360" width="380" height="460" as="geometry" />
        </mxCell>

        <mxCell id="api-service" value="&lt;b&gt;API Service&lt;/b&gt;&lt;br&gt;&lt;br&gt;:8080&lt;br&gt;&lt;br&gt;Spring Boot 3.4.1 + Java 21&lt;br&gt;JPA + PostgreSQL&lt;br&gt;Redis Cache&lt;br&gt;Flyway migrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="backend-api-layer">
          <mxGeometry x="40" y="40" width="300" height="140" as="geometry" />
        </mxCell>

        <mxCell id="spring-security" value="&lt;b&gt;Spring Security&lt;/b&gt;&lt;br&gt;&lt;br&gt;ApiKeyAuthFilter&lt;br&gt;Valida: X-Admin-Api-Key&lt;br&gt;&lt;br&gt;Público: GET /api/v1/{matches,teams,leagues}&lt;br&gt;Protegido: /api/v1/admin/**" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left" vertex="1" parent="backend-api-layer">
          <mxGeometry x="40" y="200" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="collector-client" value="&lt;b&gt;DataCollectorClient&lt;/b&gt;&lt;br&gt;&lt;br&gt;RestClient → :8081&lt;br&gt;Proxy a data-collector" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10" vertex="1" parent="backend-api-layer">
          <mxGeometry x="40" y="330" width="300" height="100" as="geometry" />
        </mxCell>

        <!-- Backend Collector Layer -->
        <mxCell id="backend-collector-layer" value="Backend - Data Collector Service (Spring WebFlux)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1" vertex="1" parent="1">
